{{-- The WordPress admin theme's layout: wp-admin's chrome, the admin bar above the dark admin menu and the grey content area. It reads no page values, only the sections a page fills (see ignite_panel::theme), so an app's own view can extend it. WordPress has no dark mode, so the page stays light: the layout leaves out the ignite_html section (the light or dark mode). Ignite's CSS is still loaded, for the screens' own markup. --}}<!doctype html>
<html lang="en" class="wp-toolbar">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@yield('title') &lsaquo; @yield('ignite_brand_name', 'Mission Control')</title>
@hasSection('ignite_favicon')@yield('ignite_favicon')@endif@sectionMissing('ignite_favicon')<link rel="icon" href="{{ asset('ui::resources/images/favicon.ico') }}" sizes="any">
@endif@vite(['ui::resources/css/app.css', 'ui::resources/js/app.js'])
<style>
html.wp-toolbar { padding-top: 32px; box-sizing: border-box; }
body.wp-admin { background: #f0f0f1; color: #3c434a; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif; font-size: 13px; line-height: 1.4em; margin: 0; min-height: 100%; }
/* WordPress's link colours, except on a button: a link styled as a button ("New Post", WordPress's .page-title-action) keeps the button's own text colour, white on the blue. */
body.wp-admin a:not(.ig-btn) { color: #2271b1; }
body.wp-admin a:not(.ig-btn):hover, body.wp-admin a:not(.ig-btn):active { color: #135e96; }
body.wp-admin a.ig-btn-primary, body.wp-admin a.ig-btn-primary:hover, body.wp-admin a.ig-btn-danger { color: #fff; }
.screen-reader-text { border: 0; clip-path: inset(50%); height: 1px; margin: -1px; overflow: hidden; padding: 0; position: absolute; width: 1px; word-wrap: normal; }
#wpwrap { min-height: 100%; position: relative; width: auto; }
/* The page's header around the admin bar is Ignite's: only the bar shows. */
.mc-wp-bar > header { display: contents; }
/* The admin bar. */
#wpadminbar { background: #1d2327; color: #f0f0f1; direction: ltr; font-size: 13px; font-weight: 400; height: 32px; left: 0; line-height: 2.46153846; min-width: 600px; position: fixed; top: 0; width: 100%; z-index: 99999; }
#wpadminbar ul { list-style: none; margin: 0; padding: 0; }
#wpadminbar .ab-top-menu, #wpadminbar .ab-top-secondary { display: flex; height: 32px; }
#wpadminbar .ab-top-menu { float: left; }
#wpadminbar .ab-top-secondary { float: right; }
#wpadminbar li { position: relative; }
#wpadminbar .ab-item { align-items: center; background: none; border: 0; color: #f0f0f1; cursor: pointer; display: flex; font: inherit; gap: 6px; height: 32px; padding: 0 8px; text-decoration: none; white-space: nowrap; }
#wpadminbar li:hover > .ab-item, #wpadminbar li:focus-within > .ab-item { background: #2c3338; color: #72aee6; }
#wpadminbar .ab-icon { color: #a7aaad; font-size: 20px; height: 20px; width: 20px; }
#wpadminbar li:hover > .ab-item .ab-icon { color: #72aee6; }
/* The brand's mark where WordPress's logo is: an icon-sized mark (WordPress's is a 20px Dashicon in a 34 by 32px item), on a light 24px panel so the dark mark reads on the dark bar. The full logo's wordmark would be about 4px high at the bar's height, so the bar shows the mark only. */
#wpadminbar #wp-admin-bar-wp-logo > .ab-item { padding: 0 7px; }
#wpadminbar .mc-wp-brand-panel { align-items: center; background: #fff; border-radius: 3px; box-sizing: border-box; display: flex; height: 24px; justify-content: center; width: 24px; }
#wpadminbar .mc-wp-brand-mark { display: block; height: 20px; max-width: 20px; object-fit: contain; width: auto; }
/* The user's avatar: the picture, or the initials on WordPress's grey circle. */
#wpadminbar .avatar { border: 1px solid #8c8f94; border-radius: 50%; box-sizing: border-box; flex: none; height: 18px; object-fit: cover; width: 18px; }
#wpadminbar .avatar-initials { align-items: center; background: #c3c4c7; color: #1d2327; display: inline-flex; font-size: 9px; font-weight: 600; justify-content: center; line-height: 1; text-transform: uppercase; }
#wpadminbar .avatar-64 { height: 64px; width: 64px; }
#wpadminbar .avatar-64.avatar-initials { font-size: 24px; }
#wpadminbar #wp-admin-bar-user-info .ab-item { flex-direction: column; align-items: flex-start; gap: 6px; height: auto; padding: 4px 1em 8px; }
#wpadminbar #wp-admin-bar-user-info .display-name { color: #f0f0f1; }
#wpadminbar .ab-sub-wrapper { background: #2c3338; box-shadow: 0 3px 5px rgba(0, 0, 0, 0.2); display: none; min-width: 100%; position: absolute; right: 0; top: 32px; }
/* The menu opens on hover, and on a click or the keyboard's focus: the bar's script sets .hover, as WordPress's admin-bar.js does. */
#wpadminbar .menupop:hover > .ab-sub-wrapper, #wpadminbar .menupop.hover > .ab-sub-wrapper { display: block; }
#wpadminbar .menupop.hover > .ab-item { background: #2c3338; color: #72aee6; }
#wpadminbar .ab-submenu { padding: 6px 0; }
#wpadminbar .ab-submenu .ab-item { color: #c3c4c7; height: 26px; padding: 0 1em; width: 100%; }
#wpadminbar .ab-submenu li:hover > .ab-item, #wpadminbar .ab-submenu li:focus-within > .ab-item { background: none; color: #72aee6; }
#wpadminbar form { margin: 0; }
#wp-admin-bar-menu-toggle { display: none; }
/* The admin menu. */
#adminmenuback, #adminmenuwrap, #adminmenu { background: #1d2327; width: 160px; }
#adminmenuback { bottom: -120px; left: 0; position: fixed; top: 0; z-index: 1; }
#adminmenuwrap { float: left; position: relative; z-index: 9990; }
#adminmenu { clear: left; list-style: none; margin: 12px 0; padding: 0; }
#adminmenu li { margin: 0; padding: 0; }
#adminmenu li.menu-top { min-height: 34px; position: relative; }
#adminmenu a.menu-top { align-items: flex-start; color: #f0f0f1; display: flex; font-size: 14px; font-weight: 400; line-height: 1.3; min-height: 34px; text-decoration: none; }
#adminmenu .wp-menu-image { color: rgba(240, 246, 252, 0.6); flex: none; height: 34px; text-align: center; width: 36px; }
#adminmenu .wp-menu-image .dashicons { font-size: 20px; height: 20px; padding: 7px 0; width: 20px; }
#adminmenu .wp-menu-name { padding: 8px 8px 8px 0; overflow-wrap: break-word; }
#adminmenu li.menu-top:hover > a.menu-top, #adminmenu li.menu-top > a.menu-top:focus { background: #2c3338; color: #72aee6; }
#adminmenu li.menu-top:hover .wp-menu-image, #adminmenu li.menu-top > a.menu-top:focus .wp-menu-image { color: #72aee6; }
#adminmenu li.current > a.menu-top, #adminmenu li.current:hover > a.menu-top { background: #2271b1; color: #fff; font-weight: 400; }
#adminmenu li.current .wp-menu-image, #adminmenu li.current:hover .wp-menu-image { color: #fff; }
#adminmenu .wp-submenu { background: #2c3338; display: none; list-style: none; margin: 0; padding: 7px 0 8px; }
#adminmenu li.current > .wp-submenu { display: block; }
#adminmenu li.menu-top:not(.current):hover > .wp-submenu, #adminmenu li.menu-top:not(.current):focus-within > .wp-submenu { box-shadow: 0 3px 5px rgba(0, 0, 0, 0.2); display: block; left: 160px; min-width: 160px; position: absolute; top: 0; z-index: 9999; }
#adminmenu .wp-submenu a { color: rgba(240, 246, 252, 0.7); display: block; font-size: 13px; line-height: 1.4; padding: 5px 12px; text-decoration: none; }
#adminmenu .wp-submenu a:hover, #adminmenu .wp-submenu a:focus { color: #72aee6; }
#adminmenu .wp-submenu li.current a { color: #fff; font-weight: 600; }
#adminmenu .wp-submenu-head { display: none; }
#adminmenu li.wp-menu-separator { height: 5px; margin: 0 0 6px; padding: 0; }
.mc-wp-menu-toggle { display: none; }
/* The content. */
#wpcontent { min-height: 100%; margin-left: 160px; padding-left: 20px; position: relative; }
#wpbody-content { float: left; overflow: visible; padding-bottom: 65px; width: 100%; }
.wrap { margin: 10px 20px 0 2px; }
.wrap h1 { color: #1d2327; font-size: 23px; font-weight: 400; line-height: 1.3; margin: 0 0 12px; padding: 9px 0 4px; }
.notice { background: #fff; border: 1px solid #c3c4c7; border-left-width: 4px; box-shadow: 0 1px 1px rgba(0, 0, 0, 0.04); margin: 5px 0 15px; padding: 1px 12px; }
.notice p { margin: 0.5em 0; padding: 2px; }
.notice-success { border-left-color: #00a32a; }
.notice-error { border-left-color: #d63638; }
/* WordPress's buttons (forms.css). */
body.wp-admin .button { background: #f6f7f7; border: 1px solid #2271b1; border-radius: 3px; box-sizing: border-box; color: #2271b1; cursor: pointer; display: inline-block; font-size: 13px; line-height: 2.15384615; margin: 0; min-height: 30px; padding: 0 10px; text-decoration: none; vertical-align: top; white-space: nowrap; }
body.wp-admin .button:hover { background: #f0f0f1; border-color: #0a4b78; color: #0a4b78; }
body.wp-admin .button-primary { background: #2271b1; border-color: #2271b1; color: #fff; }
body.wp-admin .button-primary:hover { background: #135e96; border-color: #135e96; color: #fff; }
/* Ignite's CSS has a utility named .fixed (position: fixed); WordPress's table.fixed is only the table layout, so its list tables stay in the page flow. */
body.wp-admin table.fixed { position: static; table-layout: fixed; }
/* The list screens, as WordPress's edit.php: the heading with its .page-title-action, the status links (.subsubsub), the search box, and the .widefat table with its heading row, striped rows and row actions under the title. */
.wp-heading-inline { display: inline-block; margin-right: 5px; }
.wrap h1.wp-heading-inline { margin-bottom: 0; }
body.wp-admin a.page-title-action { background: #f6f7f7; border: 1px solid #2271b1; border-radius: 3px; color: #2271b1; cursor: pointer; display: inline-block; font-size: 13px; font-weight: 600; line-height: normal; margin-left: 4px; padding: 4px 8px; position: relative; text-decoration: none; top: -3px; }
body.wp-admin a.page-title-action:hover { background: #f0f0f1; border-color: #0a4b78; color: #0a4b78; }
.wp-header-end { border: 0; margin: -2px 0 0; visibility: hidden; }
.subsubsub { color: #646970; float: left; font-size: 13px; list-style: none; margin: 8px 0 0; padding: 0; }
.subsubsub li { display: inline-block; margin: 0; padding: 0; white-space: nowrap; }
.subsubsub li + li::before { content: "| "; }
body.wp-admin .subsubsub a { background: none; border: 0; display: inline; line-height: 2; margin: 0; padding: 0.2em; text-decoration: none; }
body.wp-admin .subsubsub a.ig-tab-active { color: #000; font-weight: 600; }
.subsubsub .count { color: #50575e; font-weight: 400; }
.mc-wp-list { clear: both; }
.mc-wp-list > .ig-card { background: none; border: 0; border-radius: 0; box-shadow: none; overflow: visible; }
.mc-wp-list .search-form { display: flex; justify-content: flex-end; margin: 0 0 8px; }
.mc-wp-list p.search-box { display: flex; flex-wrap: wrap; gap: 4px; margin: 0; max-width: 100%; }
.mc-wp-list p.search-box input[type="search"] { background: #fff; border: 1px solid #8c8f94; border-radius: 4px; box-sizing: border-box; font-size: 14px; line-height: 2; max-width: 100%; min-height: 30px; padding: 0 8px; }
.widefat { background: #fff; border: 1px solid #c3c4c7; border-spacing: 0; box-shadow: 0 1px 1px rgba(0, 0, 0, 0.04); clear: both; margin: 0; width: 100%; }
.widefat * { word-wrap: break-word; }
.widefat td, .widefat th { color: #50575e; padding: 8px 10px; text-align: left; }
.widefat thead th { border-bottom: 1px solid #c3c4c7; color: #2c3338; font-size: 14px; font-weight: 400; line-height: 1.4em; }
.widefat td { font-size: 13px; line-height: 1.5em; vertical-align: top; }
.widefat thead th a { display: inline-block; text-decoration: none; }
.striped > tbody > :nth-child(odd) { background-color: #f6f7f7; }
.wp-list-table td:first-child, .wp-list-table td.column-primary { color: #2c3338; font-size: 14px; font-weight: 600; }
.wp-list-table .column-actions { width: 0; }
.wp-list-table.mc-row-actions-moved .column-actions { display: none; }
body.wp-admin .mc-wp-list .ig-badge { background: none; border: 0; color: #50575e; display: inline; font-size: inherit; font-weight: 600; margin: 0; padding: 0; }
.mc-wp-list .ig-badge::before { content: "\2014\00a0"; }
.row-actions { color: #a7aaad; font-size: 13px; font-weight: 400; left: -9999em; padding: 2px 0 0; position: relative; }
.wp-list-table tr:hover .row-actions, .row-actions:focus-within, .wp-list-table .column-actions .row-actions { position: static; }
.row-actions > span + span::before { content: " | "; }
.row-actions form { display: inline; margin: 0; }
body.wp-admin .row-actions a, body.wp-admin .row-actions button { background: none; border: 0; border-radius: 0; box-shadow: none; color: #2271b1; cursor: pointer; display: inline; font: inherit; line-height: inherit; margin: 0; min-height: 0; padding: 0; text-decoration: none; }
body.wp-admin .row-actions a:hover, body.wp-admin .row-actions button:hover { color: #135e96; text-decoration: underline; }
body.wp-admin .row-actions .ig-btn-danger, body.wp-admin .row-actions .ig-action-danger, body.wp-admin .row-actions .submitdelete { color: #b32d2e; }
.tablenav { clear: both; margin: 6px 0 4px; min-height: 30px; padding-top: 5px; }
.tablenav .tablenav-pages { color: #646970; float: right; margin: 0 0 9px; }
.tablenav .displaying-num { margin-right: 7px; }
.tablenav .pagination-links .button { font-size: 16px; min-width: 30px; padding: 0 4px; text-align: center; }
body.wp-admin { display: flow-root; position: relative; }
#wpbody { position: relative; }
#wpbody-content { padding-bottom: 65px; }
#wpfooter { bottom: 0; color: #50575e; left: 0; padding: 10px 20px; position: absolute; right: 0; }
#wpfooter p { font-size: 13px; line-height: 1.55; margin: 0; }
#wpfooter { margin-left: 160px; }
/* Narrow screens: the bar grows to 46px and the menu opens from its toggle, as in WordPress. */
@media screen and (max-width: 782px) {
  html.wp-toolbar { padding-top: 46px; }
  #wpadminbar { height: 46px; min-width: 240px; }
  #wpadminbar .ab-top-menu, #wpadminbar .ab-top-secondary { height: 46px; }
  #wpadminbar .ab-item { height: 46px; padding: 0 12px; }
  #wpadminbar .ab-icon { font-size: 26px; height: 26px; width: 26px; }
  #wpadminbar .ab-sub-wrapper { top: 46px; }
  #wpadminbar .display-name, #wp-admin-bar-site-name .ab-label { display: none; }
  #wp-admin-bar-menu-toggle { display: block; }
  #adminmenuback, #adminmenuwrap { display: none; }
  .mc-wp-menu-toggle:checked ~ #adminmenumain #adminmenuback, .mc-wp-menu-toggle:checked ~ #adminmenumain #adminmenuwrap { display: block; width: 190px; }
  .mc-wp-menu-toggle:checked ~ #adminmenumain #adminmenu { width: 190px; }
  #adminmenuwrap { position: absolute; }
  #wpcontent, #wpfooter { margin-left: 0; }
  #wpcontent { padding-left: 10px; }
  #wpadminbar #wp-admin-bar-wp-logo > .ab-item { padding: 0 10px; }
  #wpadminbar .mc-wp-brand-panel { height: 32px; width: 32px; }
  #wpadminbar .mc-wp-brand-mark { height: 28px; max-width: 28px; }
  /* Every screen fits a phone's width, as WordPress's forms.css and list-tables.css: the wrap's margins, the fields at the full width, and the form tables and list tables stacked. */
  .wrap { margin-left: 0; margin-right: 12px; }
  body.wp-admin input:not([type="checkbox"]):not([type="radio"]):not([type="hidden"]), body.wp-admin select, body.wp-admin textarea { box-sizing: border-box; max-width: 100%; }
  body.wp-admin img, body.wp-admin video, body.wp-admin iframe { max-width: 100%; }
  .form-table, .form-table tbody, .form-table tr, .form-table th, .form-table td { display: block; width: auto; }
  .form-table th { padding: 10px 0 0; }
  .form-table td { padding: 4px 0 6px; }
  .form-table td input.regular-text, .form-table td input[type="text"], .form-table td input[type="email"], .form-table td input[type="url"], .form-table td input[type="password"], .form-table td select, .form-table td textarea { display: block; max-width: none; width: 100%; }
  .form-table td .description { display: block; }
  .wp-list-table, .wp-list-table tbody, .wp-list-table tr, .wp-list-table td { box-sizing: border-box; display: block; width: 100%; }
  .wp-list-table thead { display: none; }
  .wp-list-table td { padding: 3px 10px; }
  .wp-list-table td:first-child { padding-top: 10px; }
  .wp-list-table td:last-child { padding-bottom: 10px; }
  .wp-list-table td[data-colname]:not(.column-primary):not(:empty)::before { color: #646970; content: attr(data-colname) ": "; font-weight: 400; }
  .wp-list-table .column-actions { width: 100%; }
  .row-actions { left: auto; padding: 4px 0 0; position: static; }
  .mc-wp-list .search-form { justify-content: flex-start; }
  .subsubsub { float: none; }
}
</style>
@yield('ignite_head')@yield('ignite_stylesheets')</head>
<body class="wp-admin">
<div id="wpwrap">
@yield('ignite_aside')
<div id="wpcontent">
  <div class="mc-wp-bar">@yield('ignite_bar')</div>
  <div id="wpbody" role="main">
    <div id="wpbody-content">
      <div class="wrap">
        @yield('ignite_flash')
        @yield('content')
      </div>
    </div>
  </div>
</div>
<div id="wpfooter" role="contentinfo">
  <p id="footer-left">Thank you for creating with @yield('ignite_brand_name', 'Mission Control').</p>
</div>
</div>
<script>
// The list tables, as WordPress's: each row's actions move under the title (the first cell
// without a picture, WordPress's column-primary), and each cell takes its column's name for
// the stacked rows on a phone. Without the script the actions stay in their own column.
(function () {
  document.querySelectorAll('.mc-wp-list .wp-list-table').forEach(function (table) {
    var names = Array.prototype.map.call(table.querySelectorAll('thead th'), function (th) { return th.textContent.trim(); });
    table.querySelectorAll('tbody > tr').forEach(function (row) {
      var cells = Array.prototype.slice.call(row.children);
      cells.forEach(function (cell, i) { if (names[i]) cell.setAttribute('data-colname', names[i]); });
      var actions = row.querySelector('.column-actions .row-actions');
      var primary = cells.filter(function (cell) { return !cell.classList.contains('column-actions') && !cell.querySelector('img'); })[0];
      if (!actions || !primary) return;
      primary.classList.add('column-primary');
      primary.appendChild(actions);
    });
    table.classList.add('mc-row-actions-moved');
  });
})();
</script>
</body>
</html>
