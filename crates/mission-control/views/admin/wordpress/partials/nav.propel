{{-- The WordPress admin theme's navigation: wp-admin's admin menu (`_wp_menu_output`). Each navigation group starts after a separator, as WordPress separates its menu's groups, without a heading. An entry with links of its own (Ignite's `sub_items`: its create link, then each entry listed under it with that entry's create link, as WordPress's Posts > Add New, Categories and Tags and its Settings submenu) is a `wp-has-submenu` entry: while it or one of its links is the current page it is open (`wp-has-current-submenu wp-menu-open`) and shows its submenu in the menu; otherwise (`wp-not-current-submenu`) its submenu shows beside it while the pointer or the keyboard focus is on it, as WordPress's flyout. The submenu starts with "All" and the entry's list when it has a create link, as WordPress's `all_items`. The checkbox opens the menu from the admin bar's toggle on a narrow screen. --}}@if (signed_in)
<input id="mc-wp-menu" type="checkbox" class="mc-wp-menu-toggle screen-reader-text" aria-hidden="true" tabindex="-1">
<div id="adminmenumain" role="navigation" aria-label="Main menu">
<div id="adminmenuback"></div>
<div id="adminmenuwrap">
<ul id="adminmenu">
@foreach (section in nav_sections)@if (section.has_heading)<li class="wp-menu-separator" aria-hidden="true"></li>
@endif@foreach (group in section.items)@if (group.has_sub_items)@if (group.open)<li class="wp-has-submenu wp-has-current-submenu wp-menu-open menu-top current"><a class="wp-has-submenu wp-has-current-submenu wp-menu-open menu-top" href="{{ $group.url }}">@else<li class="wp-has-submenu wp-not-current-submenu menu-top"><a class="wp-has-submenu wp-not-current-submenu menu-top" href="{{ $group.url }}" aria-haspopup="true">@endif@elseif (group.active)<li class="menu-top current"><a class="menu-top" href="{{ $group.url }}" aria-current="page">@else<li class="menu-top"><a class="menu-top" href="{{ $group.url }}">@endif<div class="wp-menu-image" aria-hidden="true"><span class="{{ $group.icon }}"></span></div><div class="wp-menu-name">{{ $group.title }}</div></a>
@if (group.has_sub_items)<ul class="wp-submenu wp-submenu-wrap"><li class="wp-submenu-head" aria-hidden="true">{{ $group.title }}</li>@if (group.has_add)@if (group.active)<li class="wp-first-item current"><a href="{{ $group.url }}" class="wp-first-item current" aria-current="page">All {{ $group.title }}</a></li>@else<li class="wp-first-item"><a href="{{ $group.url }}" class="wp-first-item">All {{ $group.title }}</a></li>@endif@endif@foreach (link in group.sub_items)@if (link.active)<li class="current"><a href="{{ $link.url }}" aria-current="page">{{ $link.title }}</a></li>@else<li><a href="{{ $link.url }}">{{ $link.title }}</a></li>@endif@endforeach</ul>
@endif</li>
@endforeach@endforeach
</ul>
</div>
</div>
@endif
