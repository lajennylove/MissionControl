@foreach (item in app_passwords)<form id="{{ $item.form_id }}" method="post" action="{{ $revoke_action }}" data-mc-confirm="Are you sure you want to revoke this password? This action cannot be undone." hidden><input type="hidden" name="_token" value="{{ $csrf_token }}"><input type="hidden" name="uuid" value="{{ $item.uuid }}"></form>
@endforeach<script>
(function () {
  var page = document.getElementById('profile-page');
  if (!page) return;
  page.classList.add('js');
  var pass1 = document.getElementById('pass1');
  var pass2 = document.getElementById('pass2');
  var box = page.querySelector('.wp-pwd');
  var set = page.querySelector('[data-mc-set-password]');
  function generate() {
    // As wp_generate_password( 24 ): letters, digits and WordPress's special characters.
    var chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()';
    var random = new Uint32Array(24);
    crypto.getRandomValues(random);
    var password = '';
    for (var i = 0; i < random.length; i++) password += chars[random[i] % chars.length];
    pass1.type = 'text';
    pass1.value = password;
    pass2.value = password;
    pass1.focus();
  }
  function open(show) {
    box.classList.toggle('hide-if-js', !show);
    set.hidden = show;
    set.setAttribute('aria-expanded', show ? 'true' : 'false');
  }
  if (box.hasAttribute('data-mc-open')) open(true);
  set.addEventListener('click', function () { open(true); generate(); });
  page.querySelector('[data-mc-generate-password]').addEventListener('click', generate);
  page.querySelector('[data-mc-hide-password]').addEventListener('click', function (event) {
    var hidden = pass1.type === 'password';
    pass1.type = hidden ? 'text' : 'password';
    event.currentTarget.textContent = hidden ? 'Hide' : 'Show';
  });
  page.querySelector('[data-mc-cancel-password]').addEventListener('click', function () {
    pass1.value = '';
    pass2.value = '';
    pass1.type = 'password';
    open(false);
  });
  // The repeated password is WordPress's no-script field: with the script, it follows the first.
  pass1.addEventListener('input', function () { pass2.value = pass1.value; });
  // "Display name publicly as" follows the names as they are typed, as user-profile.js does.
  var select = document.getElementById('display_name');
  var field = function (id) { var input = document.getElementById(id); return input ? input.value.trim() : ''; };
  function names() {
    var first = field('first_name'), last = field('last_name');
    var list = [field('nickname'), field('user_login'), first, last];
    if (first && last) { list.push(first + ' ' + last); list.push(last + ' ' + first); }
    var chosen = select.value, out = [];
    list.forEach(function (name) { if (name && out.indexOf(name) < 0) out.push(name); });
    if (chosen && out.indexOf(chosen) < 0) out.unshift(chosen);
    select.textContent = '';
    out.forEach(function (name) {
      var option = document.createElement('option');
      option.textContent = name;
      option.selected = name === chosen;
      select.appendChild(option);
    });
  }
  ['first_name', 'last_name', 'nickname'].forEach(function (id) {
    document.getElementById(id).addEventListener('blur', names);
  });
  document.querySelectorAll('form[data-mc-confirm]').forEach(function (form) {
    form.addEventListener('submit', function (event) {
      if (!window.confirm(form.getAttribute('data-mc-confirm'))) event.preventDefault();
    });
  });
})();
</script>
