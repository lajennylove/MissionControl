{{-- The WordPress admin theme's lost password page, as wp-login.php?action=lostpassword: the same form as the panel's (the email, posted to the same action) in WordPress's card. --}}@extends('ignite::themes.wordpress.layouts.login')

@section('ignite_favicon')@include('ignite::partials.favicon')@endsection

@section('ignite_stylesheets')@include('ignite::partials.stylesheets')@endsection

@section('ignite_head')@if (theme_style)<style>{!! $theme_style !!}</style>@endif@endsection

