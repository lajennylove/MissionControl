  <form name="loginform" id="loginform" method="post" action="{{ $action }}">
    <input type="hidden" name="_token" value="{{ $csrf_token }}">
    <p>
      <label for="user_login">Email Address</label>
      <input type="text" name="email" id="user_login" class="input" value="{{ $email }}" size="20" autocapitalize="off" autocomplete="username" required>
    </p>
    <div class="user-pass-wrap">
      <label for="user_pass">Password</label>
      <input type="password" name="password" id="user_pass" class="input password-input" value="" size="20" autocomplete="current-password" spellcheck="false" required>
    </div>
    <p class="submit">
      <input type="submit" name="wp-submit" id="wp-submit" class="button button-primary button-large" value="Log In">
    </p>
  </form>
  <p id="nav"><a href="{{ $forgot_url }}">Lost your password?</a></p>
