<form role="search" method="get" class="search-form flex gap-2" action="{{ $site.url }}">
  <label>
    <span class="screen-reader-text">Search for:</span>
    <input type="search" class="search-field" placeholder="Search …" value="{{ $search_query }}" name="s">
  </label>
  <button type="submit" class="search-submit">Search</button>
</form>
