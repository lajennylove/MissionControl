{{-- A menu item's opening tag and link, for `item`; the caller closes the `<li>`. Empty
     attributes are left out, as WordPress's walker leaves them out. --}}
<li id="menu-item-{{ $item.id }}" class="{{ $item.classes }}">
@if ($item.url)
<a href="{{ $item.url }}"@if ($item.target) target="{{ $item.target }}"@endif@if ($item.rel) rel="{{ $item.rel }}"@endif@if ($item.attr_title) title="{{ $item.attr_title }}"@endif@if ($item.current) aria-current="{{ $item.aria_current }}"@endif>{{ $item.title }}</a>
@else
<a>{{ $item.title }}</a>
@endif
