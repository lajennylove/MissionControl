<footer class="site-footer mt-16 border-t border-hairline py-8 text-sm text-muted">
  @if ($sidebars.footer.active)
  <aside class="widget-area site-container mb-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3" aria-label="{{ $sidebars.footer.name }}">
    @foreach (widget in sidebars.footer.widgets)
    <section id="{{ $widget.id }}" class="widget {{ $widget.classes }}">
      @if ($widget.title)
      <h2 class="widget-title mb-2 font-semibold text-heading">{{ $widget.title }}</h2>
      @endif
      {!! $widget.content !!}
    </section>
    @endforeach
  </aside>
  @endif
  <div class="site-container">
    <p>{{ $site.name }} · Proudly powered by Mission Control</p>
  </div>
</footer>
